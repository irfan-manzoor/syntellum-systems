# ----------------------------------------------------------------------
# SYNTELLUM SYSTEMS — PRODUCTION APACHE / LITESPEED CONFIGURATION
# Canonical Hostname: https://syntellum.si/
# ----------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Enforce HTTPS (301 Permanent Redirect)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://syntellum.si/$1 [R=301,L]

  # 2. Enforce Canonical Hostname (redirect www.syntellum.si -> syntellum.si)
  RewriteCond %{HTTP_HOST} ^www\.syntellum\.si$ [NC]
  RewriteRule ^(.*)$ https://syntellum.si/$1 [R=301,L]

  # 3. SPA Routing: Serve existing files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d [OR]
  RewriteCond %{REQUEST_FILENAME} -l
  RewriteRule ^ - [L]

  # 4. Route all clean paths (e.g. /services/ai-engineering) to index.html with HTTP 200
  RewriteRule ^ index.html [L]
</IfModule>

# ----------------------------------------------------------------------
# PERFORMANCE & BROWSER CACHING
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  
  # Ensure index.html is revalidated immediately so updates propagate
  ExpiresByType text/html "access plus 0 seconds"
  
  # Static fingerprinted assets cached long-term
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ----------------------------------------------------------------------
# SECURITY HEADERS
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
